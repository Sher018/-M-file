    "tieBreakers": [
      "Prefer cluster with higher direct clusterBoost over pure affinity.",
      "If still tied, prefer cluster matching top value + top motivation combo (see comboHints)."
    ],
    "comboHints": [
      {
        "when": { "valuesTop": "val_benevolence", "motivationTop": "mot_identified" },
        "boost": { "medicine": 4, "education": 4 }
      },
      {
        "when": { "valuesTop": "val_achievement", "motivationTop": "mot_extrinsic" },
        "boost": { "business": 4, "finance": 3 }
      },
      {
        "when": { "discTop": "compliance", "traitsHigh": ["conscientiousness", "openness"] },
        "boost": { "it": 3, "engineering": 3 }
      },
      {
        "when": { "discTop": "influence", "traitsHigh": ["extraversion", "openness"] },
        "boost": { "media": 4, "international_relations": 2 }
      },
      {
        "when": { "discTop": "dominance", "valuesTop": "val_power" },
        "boost": { "business": 3, "law": 2, "international_relations": 2 }
      }
    ]
  },

  "resultSchema": {
    "type": "object",
    "properties": {
      "version": { "const": "1.0.0" },
      "completedAt": { "type": "string", "format": "date-time" },
      "answers": {
        "type": "object",
        "additionalProperties": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 5 },
            { "type": "string", "pattern": "^[A-D]$" },
            { "type": "array", "items": { "type": "string", "pattern": "^[A-D]$" }, "maxItems": 2 }
          ]
        }
      },
      "fingerprint": {
        "traits": {
          "openness": "0-100",
          "conscientiousness": "0-100",
          "extraversion": "0-100",
          "agreeableness": "0-100",
          "stability": "0-100"
        },
        "disc": {
          "dominance": "0-100",
          "influence": "0-100",
          "steadiness": "0-100",
          "compliance": "0-100",
          "primary": "D|I|S|C",
          "secondary": "D|I|S|C|null"
        },
        "valuesTop": ["val_*", "val_*", "val_*"],
